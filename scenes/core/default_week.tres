[gd_resource type="Resource" script_class="WeekPlan" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/core/week_plan.gd" id="1_week"]
[ext_resource type="Script" path="res://scripts/core/stage_definition.gd" id="2_day"]
[ext_resource type="Script" path="res://scripts/core/microgame_definition.gd" id="3_game"]

[sub_resource type="Resource" id="Game_monday_canvas"]
script = ExtResource("3_game")
id = &"canvas"
tutorial_enabled = true
title = "Canvas Upload"
prompt = "UPLOAD"
scene_path = "res://scenes/microgames/canvas.tscn"
difficulty = 0

[sub_resource type="Resource" id="Game_crossing"]
script = ExtResource("3_game")
id = &"crossing"
tutorial_enabled = true
title = "Campus Crossing"
prompt = "CROSS"
scene_path = "res://scenes/microgames/crossing.tscn"
difficulty = 0

[sub_resource type="Resource" id="Game_schedule"]
script = ExtResource("3_game")
id = &"schedule"
title = "Schedule Builder"
prompt = "REGISTER"
scene_path = "res://scenes/microgames/schedule_builder.tscn"
difficulty = 0

[sub_resource type="Resource" id="Game_focus"]
script = ExtResource("3_game")
id = &"focus"
title = "Stay Focused"
prompt = "FOCUS"
scene_path = "res://scenes/microgames/stay_focused.tscn"
difficulty = 1

[sub_resource type="Resource" id="Game_gates"]
script = ExtResource("3_game")
id = &"gates"
title = "Logic Gates"
prompt = "CONNECT"
scene_path = "res://scenes/microgames/gates.tscn"
difficulty = 1

[sub_resource type="Resource" id="Game_friday_canvas"]
script = ExtResource("3_game")
id = &"canvas_final"
title = "Canvas Final Upload"
prompt = "SUBMIT"
scene_path = "res://scenes/microgames/canvas.tscn"
difficulty = 2

[sub_resource type="Resource" id="Day_monday"]
script = ExtResource("2_day")
title = "MONDAY"
games = Array[ExtResource("3_game")]([SubResource("Game_monday_canvas"), SubResource("Game_crossing")])

[sub_resource type="Resource" id="Day_tuesday"]
script = ExtResource("2_day")
title = "TUESDAY"
games = Array[ExtResource("3_game")]([SubResource("Game_schedule")])

[sub_resource type="Resource" id="Day_wednesday"]
script = ExtResource("2_day")
title = "WEDNESDAY"
games = Array[ExtResource("3_game")]([SubResource("Game_focus")])

[sub_resource type="Resource" id="Day_thursday"]
script = ExtResource("2_day")
title = "THURSDAY"
games = Array[ExtResource("3_game")]([SubResource("Game_gates")])

[sub_resource type="Resource" id="Day_friday"]
script = ExtResource("2_day")
title = "FRIDAY"
games = Array[ExtResource("3_game")]([SubResource("Game_friday_canvas")])

[resource]
script = ExtResource("1_week")
stages = Array[ExtResource("2_day")]([SubResource("Day_monday"), SubResource("Day_tuesday"), SubResource("Day_wednesday"), SubResource("Day_thursday"), SubResource("Day_friday")])
