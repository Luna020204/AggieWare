[sub_resource type="Resource" id="Day_monday"]
script = ExtResource("2_day")
title = "MONDAY"
theme = "Orientation"
games = Array[ExtResource("3_game")]([SubResource("Game_monday_canvas"), SubResource("Game_crossing")])

[sub_resource type="Resource" id="Day_tuesday"]
script = ExtResource("2_day")
title = "TUESDAY"
theme = "Campus errands"
randomize_games = true
required_wins = 2
games = Array[ExtResource("3_game")]([SubResource("Game_schedule"), SubResource("Game_swipe"), SubResource("Game_crossing")])

[sub_resource type="Resource" id="Day_wednesday"]
script = ExtResource("2_day")
title = "WEDNESDAY"
theme = "Lecture hall"
randomize_games = true
required_wins = 2
games = Array[ExtResource("3_game")]([SubResource("Game_focus"), SubResource("Game_scope"), SubResource("Game_awake"), SubResource("Game_microscope")])

[sub_resource type="Resource" id="Day_thursday"]
script = ExtResource("2_day")
title = "THURSDAY"
theme = "Lab challenges"
randomize_games = true
required_wins = 3
games = Array[ExtResource("3_game")]([SubResource("Game_gates"), SubResource("Game_scope"), SubResource("Game_microscope")])

[sub_resource type="Resource" id="Day_friday"]
script = ExtResource("2_day")
title = "FRIDAY"
theme = "ECS 179 final"
games = Array[ExtResource("3_game")]([SubResource("Game_focus"), SubResource("Game_gates"), SubResource("Game_friday_canvas")])

[resource]
script = ExtResource("1_week")
stages = Array[ExtResource("2_day")]([SubResource("Day_monday"), SubResource("Day_tuesday"), SubResource("Day_wednesday"), SubResource("Day_thursday"), SubResource("Day_friday")])
